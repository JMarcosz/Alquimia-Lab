---
// SSR sin caché: el carrusel "Featured" lee el catálogo (Supabase) en cada
// request y no se cachea en el edge, así que una edición en el panel se ve al
// recargar. `CatalogLive` recarga sola cuando el catálogo cambia.
export const prerender = false;
import HomePage from '../components/pages/HomePage.astro';
Astro.response.headers.set('Cache-Control', 'no-store');
---
<HomePage lang="es" />
