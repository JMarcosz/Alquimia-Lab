---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import PlantillaForm from '../../../components/admin/PlantillaForm.astro';
import { adminGetRow } from '../../../lib/catalog';

const { slug } = Astro.params;
const row = slug ? await adminGetRow(slug) : null;
if (!row) return Astro.redirect('/admin', 302);
---
<AdminLayout title={`Editar · ${row.name}`}>
  <h2 style="margin-top:0">Editar: {row.name}</h2>
  <p class="note"><a href={`/plantillas-notion/${row.slug}`} target="_blank" rel="noopener">Ver página pública ↗</a></p>
  <PlantillaForm row={row} />
</AdminLayout>
