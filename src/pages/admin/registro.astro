---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { readAuditPage, type AuditRow } from '../../lib/audit';

const PAGE = 100;
const offset = Math.max(0, Number(Astro.url.searchParams.get('offset') ?? 0) || 0);

let rows: AuditRow[] = [];
let loadError: string | null = null;
try {
  rows = await readAuditPage(PAGE, offset);
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
}

const ACTION_ES: Record<string, string> = {
  create: 'Creó',
  update: 'Editó',
  delete: 'Eliminó',
  show: 'Mostró',
  hide: 'Ocultó',
  reorder: 'Reordenó',
  login: 'Entró',
  user_create: 'Creó usuario',
  user_disable: 'Cambió usuario',
};

const fmt = (iso: string) =>
  new Date(iso).toLocaleString('es-CO', { dateStyle: 'short', timeStyle: 'short' });
---
<AdminLayout title="Registro">
  <h2>Registro de cambios</h2>
  <p class="note">Quién hizo qué y cuándo. Solo visible para el super admin.</p>

  {loadError && <div class="msg err">No se pudo leer el registro: {loadError}</div>}

  <table>
    <thead><tr><th>Cuándo</th><th>Quién</th><th>Acción</th><th>Detalle</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td class="note" style="white-space:nowrap">{fmt(r.at)}</td>
          <td>
            {r.actor_email ?? '—'}<br />
            <span class="note">{r.actor_role === 'superadmin' ? 'super admin' : r.actor_role ?? ''}</span>
          </td>
          <td>{ACTION_ES[r.action] ?? r.action}{r.entity_id && <><br /><span class="note">{r.entity_id}</span></>}</td>
          <td>
            {r.summary}
            {r.diff != null && (
              <details style="margin-top:4px">
                <summary class="note">ver cambios</summary>
                <pre style="white-space:pre-wrap;font-size:12px;margin:4px 0 0">{JSON.stringify(r.diff, null, 2)}</pre>
              </details>
            )}
          </td>
        </tr>
      ))}
      {rows.length === 0 && !loadError && (
        <tr><td colspan="4" class="note">Sin movimientos todavía.</td></tr>
      )}
    </tbody>
  </table>

  <div class="pf-actions" style="margin-top:16px">
    {offset > 0 && <a class="btn" href={`/admin/registro?offset=${Math.max(0, offset - PAGE)}`}>← Más recientes</a>}
    {rows.length === PAGE && <a class="btn" href={`/admin/registro?offset=${offset + PAGE}`}>Más antiguas →</a>}
  </div>
</AdminLayout>
