---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { verifySession, SESSION_COOKIE } from '../../lib/auth';

// Ya con sesión → al panel.
if (verifySession(Astro.cookies.get(SESSION_COOKIE)?.value)) {
  return Astro.redirect('/admin', 302);
}

const next = Astro.url.searchParams.get('next') || '/admin';
const failed = Astro.url.searchParams.get('e') === '1';
---
<AdminLayout title="Entrar">
  <div style="max-width:360px;margin:8vh auto 0">
    <h2 style="margin:0 0 4px">Panel de contenido</h2>
    <p class="note">Acceso solo para Alquimia Lab.</p>
    {failed && <div class="msg err">Contraseña incorrecta.</div>}
    <form method="post" action="/api/admin/login">
      <input type="hidden" name="next" value={next} />
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
      <button class="btn primary" type="submit" style="margin-top:16px;width:100%">Entrar</button>
    </form>
  </div>
</AdminLayout>
