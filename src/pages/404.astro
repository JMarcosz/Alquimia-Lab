---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '../i18n';

const lang = 'es' as const;
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
---

<BaseLayout
  lang={lang}
  path="/404"
  title="Página no encontrada · Alquimia Lab"
  description="La página que buscas no existe o se ha movido."
  noindex
>
  <div class="notfound">
    <h1>404</h1>
    <p>{t("The page you're looking for doesn't exist or has moved.")}</p>
    <div class="hero-btns">
      <a class="btn-primary" href={L('/')}>{t('Back to home')}</a>
      <a class="btn-secondary" href={L('/servicios')}>{t('Services')}</a>
      <a class="btn-secondary" href={L('/portafolio')}>{t('Portfolio')}</a>
    </div>
  </div>
</BaseLayout>
