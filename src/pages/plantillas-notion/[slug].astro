---
// SSR: la página se renderiza en cada request leyendo de Supabase, así que
// altas, ediciones y bajas se ven sin volver a desplegar. Se cachea en el
// edge unos segundos para no golpear la base en cada visita.
export const prerender = false;

import PlantillaPage from "../../components/pages/PlantillaPage.astro";
import { getPlantilla } from "../../lib/catalog";

const plantilla = await getPlantilla(Astro.params.slug!);
if (!plantilla) return new Response(null, { status: 404 });

Astro.response.headers.set('Cache-Control', 'no-store');
---
<PlantillaPage lang="es" plantilla={plantilla} />
