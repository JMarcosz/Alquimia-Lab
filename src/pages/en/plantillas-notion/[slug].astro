---
import PlantillaPage from "../../../components/pages/PlantillaPage.astro";
import type { Plantilla } from "../../../data/plantillas";
import { getPlantillas } from "../../../lib/catalog";

export async function getStaticPaths() {
  const plantillas = await getPlantillas();
  return plantillas.map((p) => ({ params: { slug: p.slug }, props: { plantilla: p } }));
}

const { plantilla } = Astro.props as { plantilla: Plantilla };
---
<PlantillaPage lang="en" plantilla={plantilla} />
