---
export const prerender = false;

import PlantillaPage from "../../../components/pages/PlantillaPage.astro";
import { getPlantilla } from "../../../lib/catalog";

const plantilla = await getPlantilla(Astro.params.slug!);
if (!plantilla) return new Response(null, { status: 404 });

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=60, stale-while-revalidate=86400",
);
---
<PlantillaPage lang="en" plantilla={plantilla} />
