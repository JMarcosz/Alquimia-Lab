---
/**
 * Cascarón mínimo del panel. NO usa BaseLayout: nada de nav pública, footer,
 * i18n ni SEO. `noindex` explícito por si la ruta se filtra.
 *
 * Tema: mismo que el sitio público (tokens.css → paleta morada + Quicksand),
 * pero con sus propios componentes en admin.css.
 */
import '../styles/admin.css';

interface Props {
  title: string;
}
const { title } = Astro.props;

const user = Astro.locals.user;
const role = Astro.locals.role;
const isSuperadmin = role === 'superadmin';
const path = Astro.url.pathname;
const onLogin = path === '/admin/login';

const navItems = [
  { href: '/admin', label: 'Productos', show: true },
  { href: '/admin/usuarios', label: 'Usuarios', show: isSuperadmin },
  { href: '/admin/registro', label: 'Registro', show: isSuperadmin },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin · Alquimia Lab</title>
    <link
      rel="preload"
      href="/fonts/quicksand-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="wrap">
      <header class="admin">
        <h1><a href="/admin">Alquimia Lab · Admin</a></h1>
        {!onLogin && user && (
          <nav class="admin-nav">
            {navItems.filter((i) => i.show).map((i) => (
              <a href={i.href} aria-current={path === i.href ? 'page' : undefined}>{i.label}</a>
            ))}
          </nav>
        )}
        <span class="sp"></span>
        <slot name="actions" />
        {!onLogin && user && (
          <div class="admin-tail">
            <span class="note admin-whoami">
              {user.email} · <strong>{isSuperadmin ? 'Super admin' : 'Editora'}</strong>
            </span>
            <form method="post" action="/api/admin/logout">
              <button class="btn" type="submit">Salir</button>
            </form>
          </div>
        )}
      </header>
      <slot />
    </div>
  </body>
</html>
