---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogLive from '../CatalogLive.astro';
import Pic from '../Pic.astro';
import Icon from '../Icon.astro';
import { useTranslations, localizePath, type Lang } from '../../i18n';
import { getPlantillas } from '../../lib/catalog';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

const plantillas = await getPlantillas();

const categories = [
  {
    icon: 'clipboard-list',
    title: 'Notion Templates',
    text: 'Organization systems for freelancers, planning, and personal productivity.',
    href: L('/productos'),
  },
  {
    icon: 'printer',
    title: 'Printed Products',
    text: 'Coloring books with a lofi aesthetic and designs that invite you to unwind.',
    href: L('/productos'),
  },
  {
    icon: 'palette',
    title: 'Explore Design Portfolio',
    text: 'Bold brand identities, intuitive UI/UX, and social media visuals crafted to captivate.',
    href: L('/portafolio'),
  },
];

// El carrusel refleja el catálogo (Supabase): las plantillas activas, en el
// mismo orden que /productos. Editar una plantilla en el panel se ve aquí sin
// tocar código. `href` apunta a la ficha externa de compra/duplicado.
const featured = plantillas.map((p) => {
  const c = p[lang];
  const free = /free/i.test(p.price);
  return {
    image: p.image ?? null,
    img: p.img ?? null,
    icon: p.icon ?? null,
    title: p.name,
    text: c.intro,
    href: p.href,
    btn: free ? 'btn-secondary' : 'btn-primary',
  };
});
// The track is duplicated for the seamless infinite-scroll animation.
const featuredLoop = [...featured, ...featured];
---

<BaseLayout
  lang={lang}
  path="/"
  active="home"
  title="Alquimia Lab · Notion templates & brand design"
  description="Brand identity, UI/UX and social media design, plus Notion templates in Spanish. Isabel Correa Boder, graphic designer in Bogotá, Colombia."
  ogImageAlt="Alquimia Lab — diseño de marca y plantillas de Notion, Bogotá"
>
  <!-- BANNER -->
  <section class="hero-banner">
    <Pic
      name="banner-home.png"
      alt="Alquimia Lab — estudio de diseño gráfico en Bogotá"
      class="hero-banner-img"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-banner-overlay">
      <Pic name="logo-alquimia.png" alt="Logo de Alquimia Lab" class="hero-logo anim" sizes="200px" maxWidth={480} loading="eager" />
      <h1 class="anim d1">{t('Brand design and Notion templates from Bogotá')}</h1>
      <p class="anim d2">
        {t(
          'I create digital tools and designs that bring clarity and calm to your daily routine. Notion templates, coloring books, productivity tools, and visual design solutions.',
        )}
      </p>
      <div class="hero-btns anim d3">
        <a class="btn-primary btn-light" href={L('/portafolio')}>{t('View Portfolio')}</a>
        <a class="btn-secondary btn-light" href={L('/servicios')}>{t('Services')}</a>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section">
    <h2 class="section-title anim"><span>{t('What is Alquimia Lab')}</span></h2>
    <p class="section-intro anim d1">
      {t(
        'Alquimia Lab is the studio of Isabel Correa Boder, a graphic designer in Bogotá, Colombia. I design brand identity, UI/UX experiences and social media content, and I build Notion templates to organize work.',
      )}{' '}
      {t(
        'Alquimia Lab is where thoughtful design meets mindful living. I craft digital sanctuaries and creative tools designed to help you quiet mental noise, organize your workflow, and embrace a calmer daily rhythm.',
      )}
    </p>

    <div class="category-grid anim d2">
      {
        categories.map((c) => (
          <a class="category-card" href={c.href}>
            <div class="category-icon"><Icon name={c.icon as any} size={28} /></div>
            <h3>{t(c.title)}</h3>
            <p>{t(c.text)}</p>
            <span class="btn-secondary btn-sm">{t('Explore')}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section" style="padding-top: 0;">
    <h2 class="section-title anim"><span>{t('Featured')}</span></h2>

    <div class="featured-scroll anim d1">
      <div class="featured-track">
        {
          featuredLoop.map((f) => (
            <div class="featured-card">
              {f.image ? (
                <img src={f.image} alt={f.title} class="featured-thumb" loading="lazy" decoding="async" />
              ) : f.img ? (
                <Pic name={f.img} alt={f.title} class="featured-thumb" />
              ) : (
                <div
                  class="featured-thumb"
                  style="display:flex;align-items:center;justify-content:center;background:var(--lavender-light);color:var(--purple);"
                >
                  {f.icon ? <Icon name={f.icon as any} size={24} /> : null}
                </div>
              )}
              <div class="featured-info">
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                <a
                  href={f.href}
                  target="_blank"
                  rel="noopener"
                  class={`${f.btn} btn-sm`}
                  aria-label={`${t('Get it')} — ${f.title}`}
                >
                  {t('Get it')}
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="text-align: center; padding-top: 0;">
    <a class="btn-primary anim" href={L('/productos')} style="min-width:280px; justify-content:center;">
      {t('Explore all products')}
    </a>
  </section>
  <CatalogLive />
</BaseLayout>
