---
/**
 * Reusable modal shell. Open/close is handled by delegated listeners in
 * ModalScript.astro (triggers use `data-open="<id>"`, closers `data-close`).
 */
interface Props {
  id: string;
  title: string;
  wide?: boolean;
}
const { id, title, wide = false } = Astro.props;
---
<div class="modal-overlay" id={id} aria-hidden="true">
  <div class={wide ? 'modal modal-wide' : 'modal'} role="dialog" aria-modal="true" aria-label={title}>
    <button class="modal-close" aria-label="Close" data-close>&times;</button>
    <h3 class="modal-title">{title}</h3>
    <slot />
  </div>
</div>
