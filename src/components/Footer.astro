---
/**
 * Pie de página con navegación real.
 *
 * ANTES: una sola línea con el copyright, sin un solo enlace. En un sitio de
 * 29 páginas eso desaprovecha por completo el enlazado interno del footer,
 * que es la forma más barata de repartir autoridad hacia las páginas
 * comerciales y de darle a Google rutas de rastreo alternativas.
 * También añade el bloque NAP (nombre, zona, teléfono), señal de SEO local.
 */
import { useTranslations, localizePath, type Lang } from '../i18n';
import {
  SITE_NAME,
  AUTHOR_NAME,
  CONTACT_EMAIL,
  PHONE_DISPLAY,
  PHONE_E164,
  WHATSAPP_URL,
  BUSINESS_CITY,
  BUSINESS_COUNTRY,
  SOCIAL_LINKS,
} from '../consts';
import { servicios } from '../data/servicios';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
const es = lang === 'es';

const year = new Date().getFullYear();

/*
 * El footer YA NO lista plantillas concretas.
 *
 * Lo hacía con `getPlantillas().slice(0, 4)`, pero el footer va en TODAS las
 * páginas y la mayoría (servicios, portafolio, branding…) son estáticas: esos
 * 4 nombres quedaban congelados en el build y contradecían al panel en cuanto
 * se renombraba o reordenaba un producto. Como el catálogo debe salir solo de
 * la base de datos y verse al instante, el footer enlaza a los hubs —que son
 * SSR y siempre están al día— en vez de duplicar una porción del catálogo.
 */

const cols = [
  {
    title: es ? 'Servicios' : 'Services',
    links: servicios.map((s) => ({
      label: s[lang].short,
      href: L(`/servicios/${s.slug}`),
    })),
  },
  {
    title: es ? 'Plantillas de Notion' : 'Notion templates',
    links: [
      {
        label: es ? 'Todas las plantillas' : 'All templates',
        href: L('/plantillas-notion'),
      },
      { label: t('Products'), href: L('/productos') },
    ],
  },
  {
    title: es ? 'Estudio' : 'Studio',
    links: [
      { label: t('Portfolio'), href: L('/portafolio') },
      { label: t('Products'), href: L('/productos') },
      { label: t('Contact'), href: L('/contacto') },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{SITE_NAME}</p>
      <!-- Bloque NAP: nombre, zona de servicio y teléfono, coherentes con el
           JSON-LD de ProfessionalService. Señal de SEO local. -->
      <p class="footer-nap">
        {AUTHOR_NAME}<br />
        {es ? 'Diseño gráfico en' : 'Graphic design in'} {BUSINESS_CITY}, {BUSINESS_COUNTRY}
      </p>
      <p class="footer-contact">
        <a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a><br />
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
        <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>
      </p>
      <ul class="footer-social">
        {
          SOCIAL_LINKS.map((url) => {
            const net = url.includes('instagram')
              ? 'Instagram'
              : url.includes('youtube')
                ? 'YouTube'
                : url.includes('facebook')
                  ? 'Facebook'
                  : 'Web';
            return (
              <li>
                <a href={url} target="_blank" rel="me noopener">
                  {net}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    {
      cols.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <h2 class="footer-col-title">{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <p class="footer-legal">
    {year} &copy; <a href="https://jeanmarte.com" target="_blank" rel="noopener noreferrer">Jean Marte</a> - {es ? 'Desarrollo Web' : 'Web Development'} - {es ? 'Todos los Derechos Reservados' : 'All Rights Reserved'}
  </p>
</footer>
