---
/**
 * Migas de pan visibles + JSON-LD `BreadcrumbList`.
 * `items`: del primero (Inicio) al último (página actual). El último sin `href`.
 */
import { SITE_URL } from '../consts';

interface Crumb {
  name: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const abs = (href: string) => (href.startsWith('http') ? href : `${SITE_URL}${href}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.href ? { item: abs(c.href) } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label="Migas de pan">
  <ol>
    {
      items.map((c, i) => (
        <li>
          {c.href && i < items.length - 1 ? (
            <a href={c.href}>{c.name}</a>
          ) : (
            <span aria-current="page">{c.name}</span>
          )}
          {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
