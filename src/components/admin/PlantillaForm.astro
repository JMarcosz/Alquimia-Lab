---
/**
 * Formulario de alta/edición de un producto (plantilla de Notion).
 *
 * Según el rol:
 *  - `editor` (la clienta): formulario sencillo — nombre, precio, enlace,
 *    imagen, orden. Nada de slug, textos SEO ni FAQ. Al crear, el producto
 *    entra oculto.
 *  - `superadmin`: formulario completo (slug + ES/EN + FAQ).
 *
 * Envía JSON:  alta → POST /api/admin/productos ·  edición → PATCH /api/admin/productos/:slug
 */
import type { PlantillaRow } from '../../lib/catalog';
import type { Role } from '../../lib/session';

interface Props {
  row: PlantillaRow | null;
  role: Role;
}
const { row, role } = Astro.props;
const isNew = row === null;
const isEditor = role === 'editor';

const langBlock = (lang: 'es' | 'en') => {
  const l = row?.[lang];
  return {
    title: l?.title ?? '',
    metaDescription: l?.metaDescription ?? '',
    h1: l?.h1 ?? '',
    intro: l?.intro ?? '',
    forWho: (l?.forWho ?? []).join('\n'),
    includes: (l?.includes ?? []).join('\n'),
    faq: l?.faq ?? [],
  };
};
const ES = langBlock('es');
const EN = langBlock('en');
const faqRows = Math.max(ES.faq.length, EN.faq.length, 1);
---
<form id="pf" data-new={String(isNew)} data-slug={row?.slug ?? ''} data-mode={isEditor ? 'editor' : 'full'}>
  <div id="msg"></div>

  <div class="pf-grid-2">
    {!isEditor && (
      <div>
        <label for="slug">Slug (URL)</label>
        <input id="slug" name="slug" value={row?.slug ?? ''} readonly={!isNew}
          placeholder="plantilla-de-algo" pattern="[a-z0-9]+(-[a-z0-9]+)*" />
        <span class="note">
          {isNew ? 'Si lo dejas vacío se genera del nombre.' : 'El slug no se cambia: es la URL publicada.'}
        </span>
      </div>
    )}
    <div>
      <label for="name">Nombre</label>
      <input id="name" name="name" value={row?.name ?? ''} required />
    </div>
    <div>
      <label for="price">Precio (tal cual se muestra)</label>
      <input id="price" name="price" value={row?.price ?? ''} placeholder="$9.99 o Free" required />
    </div>
    <div>
      <label for="href">Enlace de compra / duplicado</label>
      <input id="href" name="href" value={row?.href ?? ''} placeholder="https://..." required />
    </div>
    <div>
      <label for="sort">Orden</label>
      <input id="sort" name="sort" type="number" value={row?.sort ?? 0} />
    </div>
    <div>
      <label for="icon">Icono Lucide (si no hay imagen)</label>
      <input id="icon" name="icon" value={row?.icon ?? ''} placeholder="graduation-cap" />
    </div>
  </div>

  <label class="pf-cover-label">Imagen de portada</label>
  <div class="pf-cover">
    <img id="img-preview" class="pf-img-preview" src={row?.image_url ?? ''} alt=""
      style={row?.image_url ? undefined : 'display:none'} />
    <div>
      <input id="img-file" type="file" accept="image/*" />
      <input type="hidden" id="image_url" name="image_url" value={row?.image_url ?? ''} />
      <input type="hidden" id="img" name="img" value={row?.img ?? ''} />
      <p class="note" id="img-status">
        Se comprime en tu navegador a WebP (máx. 1600px de ancho) antes de subir.
        {row?.img && !row?.image_url && ' Portada actual (legada): ' + row.img}
      </p>
    </div>
  </div>

  {isEditor ? (
    <p class="note pf-section-gap">
      Los textos de la página (título, intro, "qué incluye", preguntas frecuentes) los gestiona
      el super admin.{isNew && ' El producto se crea oculto hasta que estén listos.'}
    </p>
  ) : (
    <>
      <div class="pf-langs">
        {(['es', 'en'] as const).map((lang) => {
          const D = lang === 'es' ? ES : EN;
          return (
            <fieldset class="pf-fieldset">
              <legend>{lang === 'es' ? 'Español' : 'English'}</legend>
              <label>Título (&le;60)</label>
              <input data-l={lang} data-k="title" value={D.title} />
              <label>Meta description (70-160)</label>
              <textarea data-l={lang} data-k="metaDescription">{D.metaDescription}</textarea>
              <label>H1</label>
              <input data-l={lang} data-k="h1" value={D.h1} />
              <label>Intro (2-3 frases)</label>
              <textarea data-l={lang} data-k="intro">{D.intro}</textarea>
              <label>Para quién es (una línea por punto)</label>
              <textarea data-l={lang} data-k="forWho" rows="4">{D.forWho}</textarea>
              <label>Qué incluye (una línea por punto)</label>
              <textarea data-l={lang} data-k="includes" rows="4">{D.includes}</textarea>
            </fieldset>
          );
        })}
      </div>

      <h3 class="pf-section-gap">FAQ</h3>
      <p class="note">Cada pregunta con su respuesta en español e inglés.</p>
      <div id="faqs">
        {Array.from({ length: faqRows }).map((_, i) => (
          <div class="faq-row pf-faq-row">
            <div class="pf-faq-grid">
              <div>
                <label>Pregunta (ES)</label>
                <input class="faq" data-l="es" data-k="q" value={ES.faq[i]?.q ?? ''} />
                <label>Respuesta (ES)</label>
                <textarea class="faq" data-l="es" data-k="a">{ES.faq[i]?.a ?? ''}</textarea>
              </div>
              <div>
                <label>Pregunta (EN)</label>
                <input class="faq" data-l="en" data-k="q" value={EN.faq[i]?.q ?? ''} />
                <label>Respuesta (EN)</label>
                <textarea class="faq" data-l="en" data-k="a">{EN.faq[i]?.a ?? ''}</textarea>
              </div>
            </div>
            <button type="button" class="btn danger faq-del">Quitar</button>
          </div>
        ))}
      </div>
      <button type="button" id="faq-add" class="btn">+ Añadir pregunta</button>
    </>
  )}

  <div class="pf-actions">
    <button type="submit" id="save" class="btn primary">Guardar</button>
    <a class="btn" href="/admin">Cancelar</a>
    {!isNew && <button type="button" id="del" class="btn danger push-end">Eliminar</button>}
  </div>
</form>

<script>
  const form = document.getElementById('pf') as HTMLFormElement;
  const msg = document.getElementById('msg')!;
  const saveBtn = document.getElementById('save') as HTMLButtonElement;
  const isNew = form.dataset.new === 'true';
  const mode = form.dataset.mode; // 'editor' | 'full'
  const rowSlug = form.dataset.slug || '';

  function show(kind: 'ok' | 'err', text: string) {
    msg.className = `msg ${kind}`;
    msg.textContent = text;
    msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() ?? '';

  // ---- Imagen: comprimir en el navegador y subir ----
  const fileInput = document.getElementById('img-file') as HTMLInputElement;
  const imgUrl = document.getElementById('image_url') as HTMLInputElement;
  const preview = document.getElementById('img-preview') as HTMLImageElement;
  const imgStatus = document.getElementById('img-status')!;

  async function compress(file: File, maxW = 1600, quality = 0.8): Promise<Blob> {
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, maxW / bmp.width);
    const w = Math.round(bmp.width * scale);
    const h = Math.round(bmp.height * scale);
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, w, h);
    return await new Promise((res, rej) =>
      canvas.toBlob((b) => (b ? res(b) : rej(new Error('toBlob falló'))), 'image/webp', quality),
    );
  }

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    try {
      imgStatus.textContent = 'Comprimiendo…';
      const blob = await compress(file);
      const slugForName = val('slug') || val('name') || 'producto';
      imgStatus.textContent = `Subiendo (${Math.round(blob.size / 1024)} KB)…`;
      const r = await fetch(`/api/admin/upload?slug=${encodeURIComponent(slugForName)}`, {
        method: 'POST',
        headers: { 'content-type': 'image/webp' },
        body: blob,
      });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error || `HTTP ${r.status}`);
      imgUrl.value = data.url;
      preview.src = data.url;
      preview.style.display = '';
      imgStatus.textContent = `Listo: ${Math.round(blob.size / 1024)} KB`;
    } catch (e) {
      imgStatus.textContent = 'Error al subir: ' + (e as Error).message;
    }
  });

  // ---- FAQ dinámica (solo formulario completo) ----
  const faqs = document.getElementById('faqs');
  document.getElementById('faq-add')?.addEventListener('click', () => {
    const first = faqs!.querySelector('.faq-row');
    const clone = first!.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('input, textarea').forEach((el) => ((el as HTMLInputElement).value = ''));
    faqs!.appendChild(clone);
  });
  faqs?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.classList.contains('faq-del') && faqs!.querySelectorAll('.faq-row').length > 1) {
      t.closest('.faq-row')!.remove();
    }
  });

  function collectLang(lang: string) {
    const g = (k: string) =>
      (form.querySelector(`[data-l="${lang}"][data-k="${k}"]`) as HTMLInputElement)?.value.trim() ?? '';
    const lines = (k: string) => g(k).split('\n').map((s) => s.trim()).filter(Boolean);
    const faq: { q: string; a: string }[] = [];
    faqs?.querySelectorAll('.faq-row').forEach((rowEl) => {
      const q = (rowEl.querySelector(`.faq[data-l="${lang}"][data-k="q"]`) as HTMLInputElement).value.trim();
      const a = (rowEl.querySelector(`.faq[data-l="${lang}"][data-k="a"]`) as HTMLTextAreaElement).value.trim();
      if (q || a) faq.push({ q, a });
    });
    return {
      title: g('title'),
      metaDescription: g('metaDescription'),
      h1: g('h1'),
      intro: g('intro'),
      forWho: lines('forWho'),
      includes: lines('includes'),
      faq,
    };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    show('ok', 'Guardando…');

    const base: Record<string, unknown> = {
      name: val('name'),
      price: val('price'),
      href: val('href'),
      sort: Number(val('sort') || 0),
      icon: val('icon') || null,
      image_url: imgUrl.value.trim() || null,
    };
    if (mode === 'full') {
      base.img = val('img') || null;
      base.es = collectLang('es');
      base.en = collectLang('en');
      const slug = val('slug');
      if (slug) base.slug = slug;
    }

    const url = isNew ? '/api/admin/productos' : `/api/admin/productos/${encodeURIComponent(rowSlug)}`;
    const method = isNew ? 'POST' : 'PATCH';

    try {
      const r = await fetch(url, {
        method,
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(base),
      });
      const data = await r.json();
      if (!r.ok) throw new Error((data.issues || [data.error]).filter(Boolean).join('\n'));
      location.href = '/admin?ok=' + (isNew ? 'created' : 'saved');
    } catch (err) {
      show('err', 'No se guardó:\n' + (err as Error).message);
      saveBtn.disabled = false;
    }
  });

  // ---- Eliminar ----
  document.getElementById('del')?.addEventListener('click', async () => {
    if (!confirm(`¿Eliminar "${rowSlug}"? La URL /plantillas-notion/${rowSlug} dejará de existir.`)) return;
    const r = await fetch(`/api/admin/productos/${encodeURIComponent(rowSlug)}`, { method: 'DELETE' });
    if (r.ok) location.href = '/admin?ok=deleted';
    else show('err', 'No se pudo eliminar.');
  });
</script>
