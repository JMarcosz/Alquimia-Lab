---
/**
 * Imagen responsive servida desde variantes PREGENERADAS.
 *
 * No usa `astro:assets`: las variantes AVIF y WebP se generan en local con
 * `npm run images` y se commitean en `public/img/opt/`. Vercel solo las copia.
 *
 * POR QUÉ
 * Transformar en el build llevaba el despliegue a ~15 min. AVIF codifica 4,2x
 * más lento que WebP y eran ~400 codificaciones por despliegue, idénticas cada
 * vez aunque no cambiara ninguna imagen. Ahora ese coste se paga una sola vez,
 * en local, y solo para las imágenes que cambian.
 *
 * Los nombres llevan hash de contenido, así que pueden servirse con caché
 * inmutable (ver `vercel.json`).
 */
import manifest from '../image-manifest.json';

interface Props {
  /** Nombre del archivo en `src/assets/img/`, p. ej. "banner-home.png". */
  name: string;
  alt: string;
  class?: string;
  /**
   * Pista de tamaño para el srcset. El valor por defecto asume una imagen
   * dentro de la columna de contenido; las imágenes a sangre completa DEBEN
   * pasar `sizes="100vw"` o el navegador elegirá un candidato pequeño para un
   * hueco de pantalla completa.
   */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  style?: string;
  /** Limita los anchos emitidos. Útil para logos y miniaturas. */
  maxWidth?: number;
}

type Variant = { w: number; h: number; avif: string; webp: string };
type Entry = { hash: string; width: number; height: number; variants: Variant[] };

const {
  name,
  alt,
  class: klass,
  sizes = '(max-width: 700px) 100vw, 700px',
  loading = 'lazy',
  fetchpriority,
  style,
  maxWidth,
} = Astro.props;

const entry = (manifest as Record<string, Entry>)[name];
if (!entry) {
  throw new Error(
    `<Pic>: "${name}" no está en src/image-manifest.json. ` +
      `Añade el archivo a src/assets/img/ y ejecuta \`npm run images\`.`,
  );
}

const variants = maxWidth ? entry.variants.filter((v) => v.w <= maxWidth) : entry.variants;
const usable = variants.length ? variants : [entry.variants[0]];
const largest = usable[usable.length - 1];

const srcset = (fmt: 'avif' | 'webp') => usable.map((v) => `${v[fmt]} ${v.w}w`).join(', ');
---

<picture>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={largest.webp}
    alt={alt}
    class={klass}
    width={largest.w}
    height={largest.h}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    style={style}
  />
</picture>
