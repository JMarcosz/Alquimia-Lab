---
/**
 * Iconos en línea, sin dependencia npm ni JS.
 *
 * Dos familias:
 *  - LUCIDE  → iconos de línea monocromáticos (https://lucide.dev). Heredan
 *              `currentColor`. Se usan para controles de UI (flechas, etc.).
 *  - FLAT    → iconos planos multicolor (Flat Color Icons de icons8, licencia
 *              MIT: https://github.com/icons8/flat-color-icons). Traen sus
 *              propios colores; viewBox 0 0 48 48. Se usan en las tarjetas de
 *              categoría y en las plantillas.
 *
 * Añadir un icono = pegar su marcado interno en el mapa correspondiente.
 */
export type IconName =
  | 'clipboard-list'
  | 'printer'
  | 'palette'
  | 'graduation-cap'
  | 'file-text'
  | 'chevron-down';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: klass, strokeWidth = 2 } = Astro.props;

/* Iconos de línea Lucide (monocromáticos, currentColor). */
const LUCIDE: Partial<Record<IconName, string>> = {
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
};

/* Iconos planos multicolor (Flat Color Icons, icons8 — MIT). viewBox 0 0 48 48. */
const FLAT: Partial<Record<IconName, string>> = {
  'clipboard-list':
    '<g fill="#3F51B5"><polygon points="17.8,18.1 10.4,25.4 6.2,21.3 4,23.5 10.4,29.9 20,20.3"/>' +
    '<polygon points="17.8,5.1 10.4,12.4 6.2,8.3 4,10.5 10.4,16.9 20,7.3"/>' +
    '<polygon points="17.8,31.1 10.4,38.4 6.2,34.3 4,36.5 10.4,42.9 20,33.3"/></g>' +
    '<g fill="#90CAF9"><rect x="24" y="22" width="20" height="4"/>' +
    '<rect x="24" y="9" width="20" height="4"/><rect x="24" y="35" width="20" height="4"/></g>',
  printer:
    '<rect x="9" y="11" fill="#424242" width="30" height="3"/>' +
    '<path fill="#616161" d="M4,25h40v-7c0-2.2-1.8-4-4-4H8c-2.2,0-4,1.8-4,4V25z"/>' +
    '<path fill="#424242" d="M8,36h32c2.2,0,4-1.8,4-4v-8H4v8C4,34.2,5.8,36,8,36z"/>' +
    '<circle fill="#00E676" cx="40" cy="18" r="1"/>' +
    '<rect x="11" y="4" fill="#90CAF9" width="26" height="10"/>' +
    '<path fill="#242424" d="M37.5,31h-27C9.7,31,9,30.3,9,29.5v0c0-0.8,0.7-1.5,1.5-1.5h27c0.8,0,1.5,0.7,1.5,1.5v0 C39,30.3,38.3,31,37.5,31z"/>' +
    '<rect x="11" y="31" fill="#90CAF9" width="26" height="11"/>' +
    '<rect x="11" y="29" fill="#42A5F5" width="26" height="2"/>' +
    '<g fill="#1976D2"><rect x="16" y="33" width="17" height="2"/><rect x="16" y="37" width="13" height="2"/></g>',
  palette:
    '<path fill="#E65100" d="M41,42H13c-2.2,0-4-1.8-4-4V18c0-2.2,1.8-4,4-4h28c2.2,0,4,1.8,4,4v20C45,40.2,43.2,42,41,42z"/>' +
    '<path fill="#F57C00" d="M35,36H7c-2.2,0-4-1.8-4-4V12c0-2.2,1.8-4,4-4h28c2.2,0,4,1.8,4,4v20C39,34.2,37.2,36,35,36z"/>' +
    '<circle fill="#FFF9C4" cx="30" cy="16" r="3"/>' +
    '<polygon fill="#942A09" points="17,17.9 8,31 26,31"/>' +
    '<polygon fill="#BF360C" points="28,23.5 22,31 34,31"/>',
  'graduation-cap':
    '<g fill="#37474F"><rect x="9" y="20" width="30" height="13"/><ellipse cx="24" cy="33" rx="15" ry="6"/></g>' +
    '<path fill="#78909C" d="M23.1,8.2L0.6,18.1c-0.8,0.4-0.8,1.5,0,1.9l22.5,9.9c0.6,0.2,1.2,0.2,1.8,0l22.5-9.9c0.8-0.4,0.8-1.5,0-1.9 L24.9,8.2C24.3,7.9,23.7,7.9,23.1,8.2z"/>' +
    '<g fill="#37474F"><path d="M43.2,20.4l-20-3.4c-0.5-0.1-1.1,0.3-1.2,0.8c-0.1,0.5,0.3,1.1,0.8,1.2L42,22.2V37c0,0.6,0.4,1,1,1 s1-0.4,1-1V21.4C44,20.9,43.6,20.5,43.2,20.4z"/>' +
    '<circle cx="43" cy="37" r="2"/>' +
    '<path d="M46,40c0,1.7-3,6-3,6s-3-4.3-3-6s1.3-3,3-3S46,38.3,46,40z"/></g>',
  'file-text':
    '<polygon fill="#90CAF9" points="40,45 8,45 8,3 30,3 40,13"/>' +
    '<polygon fill="#E1F5FE" points="38.5,14 29,14 29,4.5"/>' +
    '<g fill="#1976D2"><rect x="16" y="21" width="17" height="2"/><rect x="16" y="25" width="13" height="2"/>' +
    '<rect x="16" y="29" width="17" height="2"/><rect x="16" y="33" width="13" height="2"/></g>',
};

const mono = LUCIDE[name];
---

{
  mono ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={klass}
      aria-hidden="true"
      set:html={mono}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 48 48"
      class={klass}
      aria-hidden="true"
      set:html={FLAT[name]}
    />
  )
}
